{
  "name": "convert-everything",
  "version": "1.0.0",
  "description": "Convert Everything to Everything - Universal File Converter",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "electron-start": "node run-electron.js",
    "build": "react-scripts build",
    "electron-build": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "appId": "com.converteverything.app",
    "productName": "Convert Everything",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "emrahsinekli",
      "repo": "convert-everyting-desktop"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.utilities"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "docx": "^8.5.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "firebase": "^12.8.0",
    "fluent-ffmpeg": "^2.1.2",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.6.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^5.4.530",
    "potrace": "^2.1.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "sharp": "^0.33.2",
    "showdown": "^2.1.0",
    "tar": "^7.5.7",
    "turndown": "^7.1.2",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "firebase-admin": "^13.6.0",
    "wait-on": "^7.2.0"
  },
  "homepage": "./",
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
