{
  "name": "convert-everything",
  "version": "1.0.3",
  "description": "Convert Everything to Everything - Universal File Converter",
  "main": "electron/main.js",
  "scripts": {
    "start": "concurrently \"npm run react-start\" \"wait-on http://localhost:3000 && npm run electron-start\"",
    "react-start": "cross-env BROWSER=none react-scripts start",
    "electron-start": "node run-electron.js",
    "build": "react-scripts build",
    "electron-build": "npm run build && electron-builder",
    "release": "npm run build && electron-builder --mac --arm64 --publish always",
    "postinstall": "electron-builder install-app-deps && node scripts/setup-mac-natives.js"
  },
  "author": "Emrah Sinekli <emrahsinekli@gmail.com>",
  "build": {
    "appId": "com.converteverything.app",
    "productName": "Convert Everything",
    "extends": null,
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "emrahsinekli",
      "repo": "convert-everything-releases",
      "releaseType": "release"
    },
    "files": [
      "build/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*.map",
      "!node_modules/**/*.md",
      "!node_modules/**/*.ts",
      "!node_modules/**/CHANGELOG*",
      "!node_modules/**/LICENSE*",
      "!node_modules/**/README*",
      "!node_modules/**/test/**",
      "!node_modules/**/tests/**",
      "!node_modules/**/__tests__/**",
      "!node_modules/**/example/**",
      "!node_modules/**/examples/**",
      "!node_modules/**/docs/**",
      "!node_modules/ffprobe-static/bin/win32/**",
      "!node_modules/ffprobe-static/bin/linux/**",
      "!node_modules/ffprobe-static/bin/darwin/x64/**",
      "!node_modules/pdf-poppler/lib/win/**",
      "!node_modules/pdfjs-dist/**",
      "!node_modules/@napi-rs/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/win32/**",
      "!node_modules/onnxruntime-node/bin/napi-v6/linux/**",
      "!node_modules/konva/**",
      "!node_modules/react-konva/**",
      "!node_modules/react-image-crop/**",
      "!node_modules/react-compare-slider/**"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "node_modules/ffprobe-static/**",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/",
        "to": "resources/",
        "filter": [
          "**/*",
          "!**/polar.config.example.json"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.utilities",
      "identity": "Emrah Si̇nekli̇ (75CRHC6QNK)",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "notarize": {
        "teamId": "75CRHC6QNK"
      }
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "public/icon.png",
      "category": "Utility"
    }
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "chokidar": "^3.6.0",
    "docx": "^8.5.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.7.3",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.2",
    "form-data": "^4.0.5",
    "heic-convert": "^2.1.0",
    "konva": "^9.3.22",
    "mammoth": "^1.6.0",
    "onnxruntime-node": "^1.27.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.3",
    "pdfjs-dist": "^5.4.530",
    "potrace": "^2.1.8",
    "react": "^18.2.0",
    "react-compare-slider": "^4.0.0",
    "react-dom": "^18.2.0",
    "react-image-crop": "^11.1.2",
    "react-konva": "^18.2.16",
    "sharp": "^0.33.2",
    "showdown": "^2.1.0",
    "tar": "^7.5.7",
    "turndown": "^7.1.2",
    "unzipper": "^0.12.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "png-to-ico": "^3.0.1",
    "react-scripts": "5.0.1",
    "wait-on": "^7.2.0"
  },
  "homepage": "./",
  "browserslist": {
    "production": [
      "last 1 electron version"
    ],
    "development": [
      "last 1 electron version"
    ]
  }
}
